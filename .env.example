# Server-only. Copy to .env.local and restart Vite. Never use a VITE_ prefix.
OPENROUTER_API_KEY=
OPENROUTER_IMAGE_MODEL=black-forest-labs/flux.2-klein-4b
# Big Al (campus buying agent) chat model; needs tool calling.
OPENROUTER_AGENT_MODEL=openai/gpt-4.1-mini
# Optional public Uber deep-link client id. It is sent in the ride URL and is not a secret.
# Leave it blank to open Uber for manual confirmation without a pickup pin.
VITE_UBER_CLIENT_ID=


# Optional marketplace staff and providers. Leave blank for the local sandbox.
# RELAY_STAFF_EMAILS=you@ua.edu:moderator:Alabama
# STRIPE_SECRET_KEY=
# APNS_KEY=
# SMTP_URL=
