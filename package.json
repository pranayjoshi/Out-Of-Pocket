{
  "name": "relay-campus",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "ios:setup": "python3 ios/scripts/relay.py setup",
    "ios": "python3 ios/scripts/relay.py run",
    "ios:test": "python3 ios/scripts/relay.py test",
    "ios:doctor": "python3 ios/scripts/relay.py doctor",
    "dev": "vite --host 127.0.0.1",
